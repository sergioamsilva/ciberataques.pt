---
import BaseLayout from "../layouts/BaseLayout.astro";
import CartaoIncidente from "../components/CartaoIncidente.astro";
import Cronograma from "../components/Cronograma.astro";
import { incidentes, agregados, manifesto, nome, formatarNumero, entidades, documentados, alegacoes } from "../lib/dados";

const lista = incidentes();
const ag = agregados();
const m = manifesto();
/* Últimos registos: só os documentados. Uma alegação sem ficha não pode ser
   cartão numa lista de destaque da página inicial. */
const recentes = documentados().slice(0, 5);
const todasEntidades = entidades();

// O ano com mais incidentes, para a banda de manifesto. Sai dos dados: se o
// registo crescer e outro ano passar à frente, a banda acompanha sozinha.
const [anoPico, totalPico] = Object.entries(ag.por_ano).sort((a, b) => b[1] - a[1])[0];
const incidentesDoPico = lista.filter((i) => String(i.ano) === anoPico);

// Os setores saem dos dados, e não de uma lista escrita à mão: uma enumeração fixa
// ao lado de uma contagem calculada acaba sempre por divergir do registo.
const setoresDoPico = [...new Set(incidentesDoPico.map((i) => i.setor))]
  .map((s) => nome("setores", s).toLowerCase())
  .sort((a, b) => a.localeCompare(b, "pt"));
const listaSetores =
  setoresDoPico.slice(0, -1).join(", ") + " e " + setoresDoPico[setoresDoPico.length - 1];

/*
 * Os quatro números separam agora o que está documentado do que é só alegação.
 * Dizer "79 incidentes registados" e levar a uma listagem que mostra 52 seria uma
 * contradição à vista, e a distinção é o assunto do site — não uma nota de rodapé.
 */
const numeros = [
  { n: documentados().length, r: "incidentes documentados", d: "/incidentes/" },
  { n: alegacoes().length, r: "listagens por confirmar", d: "/alegacoes/" },
  { n: m.total_fontes, r: "fontes citadas", d: "/dados/" },
  { n: ag.incidentes_com_disputas, r: "com versões em confronto", d: "/metodologia/#disputas" },
];
---

<BaseLayout
  titulo="ciberataques.pt"
  descricao="Registo público e documentado de ciberataques a entidades portuguesas. Cada incidente com as suas fontes e o grau de confirmação à vista."
>
  {/* ------------------------------------------------------------------ Abertura */}
  <section class="mx-auto max-w-6xl px-5 pt-16 pb-10 sm:pt-24">
    <div class="max-w-3xl">
      <p class="mono-etiqueta revelar">
        Registo público · {m.anos[0]}–{m.anos[m.anos.length - 1]}
      </p>
      <h1 class="revelar mt-4 text-5xl leading-[1.05] sm:text-7xl">
        O que aconteceu,<br />quem o disse,<br />
        <span class="text-[var(--color-acento)]">e com que certeza.</span>
      </h1>
      <p class="revelar mt-7 max-w-2xl text-lg leading-relaxed">
        Um registo documentado dos ciberataques a entidades portuguesas. Cada incidente
        indica as fontes que o sustentam e distingue o que a entidade confirmou do que
        apenas o atacante alegou.
      </p>
      <p class="revelar mt-6 flex flex-wrap gap-x-6 gap-y-2">
        <a href="/incidentes/" class="mono-etiqueta text-[var(--color-tinta)]">
          Ver o registo →
        </a>
        <a href="/dados/" class="mono-etiqueta">Descarregar os dados</a>
        <a href="/metodologia/" class="mono-etiqueta">Como classificamos</a>
      </p>
    </div>
  </section>

  {/* --------------------------------------------- A assinatura: o cronograma */}
  <section class="mx-auto max-w-6xl px-5 py-10" aria-labelledby="h-cronograma">
    <div class="regua pt-6">
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
        <h2 id="h-cronograma" class="text-2xl">Dez anos, marca a marca</h2>
        <p class="max-w-md text-sm text-[var(--color-suave)]">
          Cada marca é um incidente. Quanto mais escura, mais sustentado está o que
          dele se sabe.
        </p>
      </div>
      <div class="mt-9">
        <Cronograma incidentes={lista} />
      </div>
    </div>
  </section>

  {/* --------------------------------------------- Fila editorial de estatísticas */}
  <section class="mx-auto max-w-6xl px-5 py-6" aria-labelledby="h-numeros">
    <h2 id="h-numeros" class="sr-only">Números do registo</h2>
    {/*
      Sem molduras. O resto do site organiza-se por filetes horizontais, à maneira
      de página impressa, e estas quatro caixas com contorno liam-se como um painel
      de controlo colado a um arquivo. O filete em cima e a régua de acento em baixo
      dizem a mesma coisa com o vocabulário que já existe, e deixam o número
      respirar — que é o que ele merece, sendo o conteúdo.
    */}
    <dl class="grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
      {numeros.map((item) => (
        <a href={item.d} class="revelar group regua block pt-3 no-underline">
          {/* Duas linhas reservadas para todos: um rótulo que quebra desalinhava a
              base dos números, e são os números que se comparam entre si. */}
          <dt class="mono-etiqueta block min-h-[2.4em] leading-[1.2]">{item.r}</dt>
          <dd
            class="mt-1 font-mono text-5xl tabular-nums leading-none text-[var(--color-tinta)]"
            data-contar={item.n}
          >
            {formatarNumero(item.n)}
          </dd>
          <span
            class="mt-3 block h-0.5 w-10 bg-[var(--color-acento)] transition-all duration-300 group-hover:w-full"
            aria-hidden="true"
          ></span>
        </a>
      ))}
    </dl>
  </section>

  {/* ------------------------------------------------- Banda de manifesto: o ano */}
  <section class="mt-10 bg-[var(--color-tinta)] py-16 text-[var(--color-sobre-tinta)]">
    <div class="mx-auto max-w-6xl px-5">
      <div class="grid items-center gap-10 lg:grid-cols-[auto_minmax(0,1fr)]">
        <p
          class="revelar font-mono text-7xl leading-none tabular-nums text-[var(--color-papel)] sm:text-9xl"
        >
          {anoPico}
        </p>
        <div class="revelar max-w-xl">
          <p class="text-xl leading-relaxed text-[var(--color-papel)]">
            {totalPico} dos {m.total_incidentes} incidentes deste registo aconteceram
            num só ano, em {setoresDoPico.length} setores diferentes: {listaSetores}.
          </p>
          <p class="mt-4 text-sm leading-relaxed">
            Não foi o ano em que Portugal passou a ser atacado. Foi o ano em que se
            passou a saber.
          </p>
          <p class="mt-5">
            <a href={`/cronologia/${anoPico}/`} class="mono-etiqueta text-[var(--color-papel)]">
              O que aconteceu em {anoPico} →
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------------ Registos */}
  <section class="mx-auto max-w-6xl px-5 py-14" aria-labelledby="h-recentes">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_18rem]">
      <div>
        <div class="regua flex flex-wrap items-baseline justify-between gap-4 pt-6">
          <h2 id="h-recentes" class="text-2xl">Últimos registos</h2>
          <a href="/incidentes/" class="mono-etiqueta">todos os incidentes →</a>
        </div>
        <div class="mt-4">
          {recentes.map((inc) => <CartaoIncidente incidente={inc} />)}
        </div>
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="border border-[var(--color-borda)] bg-[var(--color-superficie)] p-6">
          <p class="mono-etiqueta">Como lemos as fontes</p>
          <p class="mt-3 text-sm leading-relaxed">
            Um comunicado da empresa não é a mesma coisa que um número publicado por
            quem a atacou.
          </p>
          <ul class="mt-5 space-y-2.5">
            {Object.entries(ag.por_estado_confirmacao)
              .sort((a, b) => b[1] - a[1])
              .map(([estado, n]) => (
                <li class="flex items-baseline justify-between gap-3 text-sm">
                  <span>{nome("estados_confirmacao", estado)}</span>
                  <span class="font-mono text-xs tabular-nums text-[var(--color-suave)]">
                    {n}
                  </span>
                </li>
              ))}
          </ul>
          <p class="mt-5 text-sm">
            <a href="/metodologia/#escala">A escala completa →</a>
          </p>
        </div>

        <div class="mt-6 border-l-2 border-[var(--color-acento)] pl-5">
          <p class="text-sm leading-relaxed">
            Uma notícia é uma prova, não um facto. Cinco notícias sobre o mesmo ataque
            produzem um incidente com cinco fontes, não cinco páginas.
          </p>
          <p class="mt-2 font-mono text-xs text-[var(--color-suave)]">
            <a href="/metodologia/">política editorial</a>
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
