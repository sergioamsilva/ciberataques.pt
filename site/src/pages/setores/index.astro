---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  agregados,
  corDeConfianca,
  incidentes,
  nome,
  type EstadoConfirmacao,
} from "../../lib/dados";

const ag = agregados();
const maximo = Math.max(...Object.values(ag.por_setor), 1);

/*
 * A barra de cada setor deixa de dizer só "quantos" e passa a dizer também
 * "quanto disto está sustentado".
 *
 * É a mesma informação que o cronograma da página inicial dá no eixo do tempo,
 * agora no eixo do setor — e responde a uma pergunta que a contagem sozinha
 * escondia: a indústria tem nove registos, mas quase todos são listagens de sites
 * de extorsão por confirmar, enquanto a administração local tem catorze quase todos
 * confirmados pelas próprias câmaras. Uma barra só com o total daria a entender que
 * sabemos o mesmo dos dois, e não sabemos.
 */
const ORDEM: EstadoConfirmacao[] = [
  "confirmado_por_regulador",
  "confirmado_pela_entidade",
  "reportado_por_media",
  "noticiado_por_uma_fonte",
  "alegado_pelo_atacante",
  "desmentido",
];

const porSetor = new Map<string, Map<EstadoConfirmacao, number>>();
for (const inc of incidentes()) {
  if (!porSetor.has(inc.setor)) porSetor.set(inc.setor, new Map());
  const m = porSetor.get(inc.setor)!;
  m.set(inc.estado_confirmacao, (m.get(inc.estado_confirmacao) ?? 0) + 1);
}
function segmentos(setor: string) {
  const m = porSetor.get(setor) ?? new Map();
  return ORDEM.filter((e) => (m.get(e) ?? 0) > 0).map((e) => ({ estado: e, n: m.get(e)! }));
}
---

<BaseLayout
  titulo="Setores"
  descricao="Ciberataques registados em Portugal, por setor de atividade."
>
  <div class="mx-auto max-w-4xl px-5 py-10">
    <header>
      <p class="mono-etiqueta">O registo</p>
      <h1 class="mt-2 text-4xl sm:text-5xl">Setores</h1>
      <p class="mt-4 max-w-2xl text-lg">
        Distribuição dos incidentes registados por setor. Os setores seguem os anexos I
        e II da diretiva NIS2, com a administração local separada da central.
      </p>
      <p class="mt-3 max-w-2xl text-sm text-[var(--color-suave)]">
        Estas contagens são de incidentes <em>noticiados</em>, não de incidentes ocorridos.
        <a href="/metodologia/#vies">Porque é que a distinção importa</a>.
      </p>
    </header>

    {/*
      O número é o conteúdo desta página e estava em corpo 14 a cinzento, mais
      pequeno e mais pálido do que o rótulo que o acompanha — enquanto a barra, com
      meio pixel de altura, se lia como um sublinhado e não como um dado. Invertido:
      cifra tabular grande à esquerda, barra com corpo, e o acento a marcar a linha
      sobre que se está a passar o rato.
    */}
    <ul class="mt-10 divide-y divide-[var(--color-borda)] border-y border-[var(--color-borda)]">
      {Object.entries(ag.por_setor).map(([setor, n]) => (
        <li class="revelar grupo-setor py-4">
          <a href={`/setores/${setor}/`} class="group flex items-baseline gap-5 no-underline">
            <span class="w-12 shrink-0 text-right font-mono text-3xl tabular-nums leading-none text-[var(--color-tinta)]">
              {n}
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-lg group-hover:underline">{nome("setores", setor)}</span>
              {/* Um segmento por grau de confirmação, com 2px de superfície entre
                  eles: é a superfície que separa, nunca uma linha. */}
              <span
                class="barra-setor mt-2 flex h-2 gap-0.5"
                style={`width: ${Math.max(3, (n / maximo) * 100)}%`}
                role="img"
                aria-label={segmentos(setor)
                  .map((s) => `${s.n} ${nome("estados_confirmacao", s.estado)}`)
                  .join("; ")}
              >
                {segmentos(setor).map((seg) => (
                  <span
                    class="block"
                    style={`width: ${(seg.n / n) * 100}%; background: ${corDeConfianca(seg.estado)}`}
                  ></span>
                ))}
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
