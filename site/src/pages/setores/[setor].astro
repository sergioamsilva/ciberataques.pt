---
import BaseLayout from "../../layouts/BaseLayout.astro";
import IconeSetor from "../../components/IconeSetor.astro";
import CartaoIncidente from "../../components/CartaoIncidente.astro";
import NotaAlegacoes from "../../components/NotaAlegacoes.astro";
import { incidentes, nome, ehAlegacao } from "../../lib/dados";

export function getStaticPaths() {
  const setores = [...new Set(incidentes().map((r) => r.setor))];
  return setores.map((setor) => ({ params: { setor }, props: { setor } }));
}

const { setor } = Astro.props as { setor: string };
const doSetor = incidentes().filter((r) => r.setor === setor);
const lista = doSetor.filter((r) => !ehAlegacao(r));
const nAlegacoes = doSetor.length - lista.length;
const rotulo = nome("setores", setor);
---

<BaseLayout
  titulo={`Ciberataques no setor ${rotulo.toLowerCase()} em Portugal`}
  descricao={`${lista.length} ${lista.length === 1 ? "incidente registado" : "incidentes registados"} no setor ${rotulo.toLowerCase()} em Portugal.`}
>
  <div class="mx-auto max-w-4xl px-5 py-10">
    <nav aria-label="Navegação estrutural" class="mono-etiqueta">
      <a href="/setores/">Setores</a>
    </nav>
    <header class="mt-6">
      {/* O mesmo ícone da listagem, em maior: quem clicou numa linha reconhece
          onde chegou sem ter de reler o título. */}
      <h1 class="mt-2 flex items-center gap-4 text-4xl sm:text-5xl">
        <IconeSetor setor={setor} tamanho={44} clase="shrink-0 text-[var(--color-acento)]" />
        {rotulo}
      </h1>
      <p class="mt-4 text-lg">
        {lista.length} {lista.length === 1 ? "incidente registado" : "incidentes registados"}.
      </p>
    </header>
    <div class="mt-10">
      {lista.map((inc) => <CartaoIncidente incidente={inc} />)}
      <NotaAlegacoes n={nAlegacoes} contexto="deste setor" />
    </div>
  </div>
</BaseLayout>
