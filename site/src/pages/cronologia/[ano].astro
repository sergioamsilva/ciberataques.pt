---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CartaoIncidente from "../../components/CartaoIncidente.astro";
import NotaAlegacoes from "../../components/NotaAlegacoes.astro";
import ContextoOficial from "../../components/ContextoOficial.astro";
import { incidentes, agregados, ehAlegacao } from "../../lib/dados";

export function getStaticPaths() {
  const anos = [...new Set(incidentes().flatMap((r) => r.anos ?? [r.ano]))].sort((a, b) => b - a);
  return anos.map((ano) => ({ params: { ano: String(ano) }, props: { ano } }));
}

const { ano } = Astro.props as { ano: number };
/* Um incidente aparece em todos os anos que atravessa, e não só no primeiro. */
const doAno = incidentes().filter((r) => (r.anos ?? [r.ano]).includes(ano));
const lista = doAno.filter((r) => !ehAlegacao(r));
const nAlegacoes = doAno.length - lista.length;
const anos = Object.keys(agregados().por_ano).map(Number).sort((a, b) => b - a);
const i = anos.indexOf(ano);
---

<BaseLayout
  titulo={`Ciberataques em Portugal em ${ano}`}
  descricao={`${lista.length} ${lista.length === 1 ? "incidente registado" : "incidentes registados"} em Portugal em ${ano}, com fontes e grau de confirmação.`}
>
  <div class="mx-auto max-w-4xl px-5 py-10">
    <nav aria-label="Navegação estrutural" class="mono-etiqueta">
      <a href="/cronologia/">Cronologia</a>
    </nav>

    <header class="mt-6">
      <h1 class="font-mono text-6xl tabular-nums sm:text-8xl">{ano}</h1>
      <p class="mt-3 text-lg">
        {lista.length} {lista.length === 1 ? "incidente registado" : "incidentes registados"}.
      </p>
    </header>

    <div class="mt-10">
      {lista.map((inc) => <CartaoIncidente incidente={inc} />)}
      {/*
        Um incidente plurianual aparece em todos os anos que atravessa, mas o
        cronograma da página inicial põe-lhe uma marca só, no ano em que começou.
        Sem esta nota, quem vê 2015 vazio no gráfico e cheio aqui fica sem perceber
        qual dos dois está certo — estão os dois.
      */}
      {lista.some((r) => r.ano !== ano) && (
        <p class="regua mt-8 pt-4 text-sm text-[var(--color-suave)]">
          {lista.filter((r) => r.ano !== ano).length === 1
            ? "Um dos registos acima começou noutro ano"
            : `${lista.filter((r) => r.ano !== ano).length} dos registos acima começaram noutro ano`}{" "}
          e prolongou-se por {ano}. No cronograma da página inicial conta uma vez, no
          ano em que começou.
        </p>
      )}

      <NotaAlegacoes n={nAlegacoes} contexto={`de ${ano}`} />

      <div class="mt-12">
        <ContextoOficial ano={ano} />
      </div>
    </div>

    <nav class="regua mt-12 flex justify-between gap-4 pt-6" aria-label="Outros anos">
      {anos[i + 1] ? (
        <a href={`/cronologia/${anos[i + 1]}/`} class="mono-etiqueta">← {anos[i + 1]}</a>
      ) : <span></span>}
      {anos[i - 1] ? (
        <a href={`/cronologia/${anos[i - 1]}/`} class="mono-etiqueta">{anos[i - 1]} →</a>
      ) : <span></span>}
    </nav>
  </div>
</BaseLayout>
