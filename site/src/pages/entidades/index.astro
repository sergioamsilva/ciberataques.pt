---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { entidades, nome } from "../../lib/dados";

const lista = Object.values(entidades()).sort((a, b) =>
  (a.nome_curto ?? a.nome).localeCompare(b.nome_curto ?? b.nome, "pt"),
);

const porSetor = new Map<string, typeof lista>();
for (const e of lista) {
  if (!porSetor.has(e.setor)) porSetor.set(e.setor, []);
  porSetor.get(e.setor)!.push(e);
}
---

<BaseLayout
  titulo="Entidades"
  descricao="Organizações portuguesas com incidentes de cibersegurança registados."
>
  <div class="mx-auto max-w-4xl px-5 py-10">
    <header>
      <p class="mono-etiqueta">O registo</p>
      <h1 class="mt-2 text-4xl sm:text-5xl">Entidades</h1>
      <p class="mt-4 max-w-2xl text-lg">
        {lista.length} organizações com incidentes registados.
      </p>
    </header>

    {[...porSetor.entries()]
      .sort((a, b) => nome("setores", a[0]).localeCompare(nome("setores", b[0]), "pt"))
      .map(([setor, entidadesDoSetor]) => (
        <section class="mt-10">
          <h2 class="mono-etiqueta">
            <a href={`/setores/${setor}/`}>{nome("setores", setor)}</a>
          </h2>
          <ul class="mt-3 divide-y divide-[var(--color-borda)] border-y border-[var(--color-borda)]">
            {entidadesDoSetor.map((e) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-2.5">
                <a href={`/entidades/${e.id}/`}>{e.nome_curto ?? e.nome}</a>
                <span class="font-mono text-xs tabular-nums text-[var(--color-suave)]">
                  {e.incidentes.length > 0 &&
                    `${e.incidentes.length} ${e.incidentes.length === 1 ? "incidente" : "incidentes"}`}
                  {e.incidentes.length === 0 && e.incidentes_em_cascata.length > 0 && "em cascata"}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))}
  </div>
</BaseLayout>
