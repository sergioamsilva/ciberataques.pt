---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  alegacoes,
  documentados,
  entidades,
  formatarData,
  nome,
} from "../../lib/dados";

/*
 * As alegações não confirmadas, todas numa página.
 *
 * Cada uma destas teve página própria durante algum tempo, e não devia ter tido.
 * O que existe em cada caso é uma linha num site de extorsão: um nome de empresa,
 * uma data e o nome de quem publicou. Nada mais. Uma página permanente e
 * indexável por entidade, intitulada "X listada em site de extorsão", transformava
 * a afirmação de um criminoso no resultado de pesquisa mais durável sobre o nome
 * dessa empresa — e a empresa não tinha por onde a contrariar.
 *
 * Aqui a explicação é dada uma vez, aplica-se a todas, e nenhuma tem título
 * próprio a circular.
 */
const lista = alegacoes().sort((a, b) => b.data.localeCompare(a.data));
const todas = entidades();
const nDocumentados = documentados().length;

const porAno = new Map<number, typeof lista>();
for (const r of lista) {
  if (!porAno.has(r.ano)) porAno.set(r.ano, []);
  porAno.get(r.ano)!.push(r);
}
const anos = [...porAno.keys()].sort((a, b) => b - a);
---

<BaseLayout
  titulo="Listagens não confirmadas em sites de extorsão"
  descricao={`${lista.length} entidades portuguesas listadas em sites de extorsão sem qualquer confirmação independente. O que são estas listagens e porque não têm ficha própria neste registo.`}
>
  <div class="mx-auto max-w-4xl px-5 py-10">
    <nav aria-label="Navegação estrutural" class="mono-etiqueta">
      <a href="/incidentes/">O registo</a>
    </nav>

    <header class="mt-6">
      <h1 class="mt-2 text-4xl sm:text-5xl">Listagens não confirmadas</h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-[var(--color-corpo)]">
        {lista.length} entidades portuguesas apareceram em sites de extorsão sem que
        alguma vez tenha havido confirmação da entidade, de autoridade ou de um
        órgão de comunicação social. Ficam registadas aqui, e só aqui.
      </p>
    </header>

    <section class="mt-10" aria-labelledby="h-porque">
      <h2 id="h-porque" class="regua pt-4 text-2xl">Porque não têm ficha própria</h2>
      <div class="prosa mt-4 max-w-2xl leading-relaxed">
        <p>
          Do que se segue existe, em cada caso, exatamente uma coisa: uma linha
          publicada por quem diz ter atacado. Um nome, uma data e a assinatura do
          grupo. Não há comunicado, não há notícia, não há decisão de autoridade,
          não há impacto apurado, não há cronologia.
        </p>
        <p class="mt-4">
          Uma ficha por entidade seria uma página permanente e indexável,
          intitulada com o nome da empresa e a palavra extorsão, construída
          inteiramente a partir da afirmação de um criminoso — e a empresa não teria
          por onde a contrariar. O valor informativo não justifica isso. A
          explicação que aqui se dá uma vez é a mesma que teria de estar repetida em
          {lista.length} páginas, e é o que essas páginas teriam de substancial.
        </p>
        <p class="mt-4">
          Não as apagámos. Estão nos <a href="/dados/">dados abertos</a>, contam
          para as estatísticas do registo, e a qualquer momento uma delas sobe a
          incidente documentado se aparecer fonte independente — foi o que
          aconteceu, por exemplo, com casos que começaram assim e acabaram
          confirmados pela própria entidade.
        </p>
        <p class="mt-4">
          Uma listagem também não é prova de que o ataque aconteceu como o grupo
          descreve, nem sequer de que aconteceu. Reivindicar um ataque é barato e
          sem custo, e há registo de grupos a listar vítimas com dados antigos,
          recompilados ou obtidos de terceiros. Ler esta página como uma lista de
          empresas atacadas seria ler mal.
        </p>
      </div>
      <p class="mt-5 text-sm">
        <a href="/metodologia/#escala">Como classificamos</a> ·
        <a href="/incidentes/">Ver os {nDocumentados} incidentes documentados</a>
      </p>
    </section>

    <section class="mt-14" aria-labelledby="h-lista">
      <h2 id="h-lista" class="regua pt-4 text-2xl">As listagens</h2>
      <p class="mt-2 max-w-2xl text-sm text-[var(--color-suave)]">
        Por ano da listagem. A data é a da publicação no site de extorsão, que não é
        necessariamente a data de um ataque.
      </p>

      {anos.map((ano) => (
        <div class="mt-8">
          <h3 class="mono-etiqueta tabular-nums">{ano} · {porAno.get(ano)!.length}</h3>
          <ul
            class="mt-3 divide-y divide-[var(--color-borda)] border-y border-[var(--color-borda)]"
            role="list"
          >
            {porAno.get(ano)!.map((r) => {
              const alvo = r.entidades_afetadas
                .map((e) => todas[e]?.nome_curto ?? todas[e]?.nome ?? e)
                .join(", ");
              return (
                <li class="revelar flex flex-wrap items-baseline gap-x-4 gap-y-1 py-3">
                  <span class="min-w-[9rem] font-mono text-xs tabular-nums text-[var(--color-suave)]">
                    {formatarData(r.data, r.precisao_data)}
                  </span>
                  <span class="flex-1 text-base">{alvo}</span>
                  <span class="mono-etiqueta">{nome("setores", r.setor)}</span>
                  {r.ator && (
                    <span class="mono-etiqueta">
                      <span class="opacity-60">reivindicado por</span> {r.ator}
                    </span>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </section>

    <p class="regua mt-12 pt-4 text-sm text-[var(--color-suave)]">
      Representa uma destas entidades e quer corrigir ou contextualizar o registo?
      Veja o <a href="/direito-de-resposta/">direito de resposta</a>. Retiramos ou
      anotamos qualquer entrada mediante contacto, e a alteração fica visível no
      histórico público do repositório.
    </p>
  </div>
</BaseLayout>
