---
/*
 * Um ícone por setor, desenhado à mão.
 *
 * Sem biblioteca: a CSP não deixa entrar folhas nem scripts de terceiros, e uma
 * família de ícones genérica traria consigo um vocabulário visual que não é o
 * deste site. São traços de 1,75px em `currentColor`, numa grelha de 24, nus —
 * nunca dentro de caixinhas arredondadas com fundo pastel.
 *
 * Ficam decorativos por omissão: o nome do setor está sempre ao lado em texto, e
 * um ícone que repetisse esse nome a um leitor de ecrã seria ruído. Daí o
 * aria-hidden.
 */
interface Props {
  setor: string;
  tamanho?: number;
  clase?: string;
}
const { setor, tamanho = 28, clase = "" } = Astro.props;

const D: Record<string, string> = {
  // Cruz médica.
  saude: "M12 5v14M5 12h14",

  // Frontão clássico sobre colunas: o edifício do Estado.
  administracao_publica: "M3 9l9-5 9 5M5 9v9M9.5 9v9M14.5 9v9M19 9v9M3 19h18",

  // Paços do concelho: telhado, porta e janelas. Sem mastro — lia-se como chaminé.
  autarquias: "M3.5 20V9.5L12 4.5l8.5 5V20M3 20h18M10 20v-4.5h4V20M7.5 11.5h2M14.5 11.5h2",

  // Euro num círculo.
  banca_seguros:
    "M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16M15 10.2a3.6 3.6 0 1 0 0 3.8M8.6 11.2h5M8.6 13.2h5",

  // Antena e ondas.
  telecomunicacoes:
    "M12 13.5v7M8.6 10.4a4.8 4.8 0 0 1 6.8 0M6.2 8a8.2 8.2 0 0 1 11.6 0M12 10.8a1.4 1.4 0 1 0 0 2.8 1.4 1.4 0 0 0 0-2.8",

  // Gota e raio lado a lado: dentro da gota, o raio desaparecia a 28px.
  energia_agua:
    "M7 4.5c0 0 4.2 4.6 4.2 7.5A4.2 4.2 0 0 1 2.8 12C2.8 9.1 7 4.5 7 4.5zM17.5 3.5l-3.5 6.5h3.5l-3 6.5",

  // Camião de mercadorias.
  transportes:
    "M3 16.5V7h10v9.5M13 10.5h4l3 3v3h-3M6 16.5h5M7.4 15.4a1.6 1.6 0 1 0 0 3.2 1.6 1.6 0 0 0 0-3.2M17 15.4a1.6 1.6 0 1 0 0 3.2 1.6 1.6 0 0 0 0-3.2",

  // Saco de compras.
  retalho: "M5.5 8h13l-1.2 12H6.7L5.5 8zM9.3 8V6.2a2.7 2.7 0 0 1 5.4 0V8",

  // Fábrica com chaminé.
  industria: "M3 20h18M4 20v-8l5 3v-3l5 3V8.5l5 3V20M8 4h3v4.5",

  // Livro aberto.
  educacao_investigacao:
    "M12 7.2v11.4M12 7.2C10 5.7 7 5.2 3.8 5.8v11.4c3.2-.6 6.2-.1 8.2 1.4M12 7.2c2-1.5 5-2 8.2-1.4v11.4c-3.2-.6-6.2-.1-8.2 1.4",

  // Jornal.
  media: "M4 5.5h11v14H4zM15 9h4.5v8.5a2 2 0 0 1-2 2H4M6.5 9h6M6.5 12h6M6.5 15h4",

  // Balança da justiça.
  justica_defesa:
    "M12 4.5v15M7 19.5h10M4.5 8.5h15M4.5 8.5L2.5 14a3 3 0 0 0 6 0L4.5 8.5M19.5 8.5L15.5 14a3 3 0 0 0 6 0l-2-5.5M12 4.5l-4 3h8l-4-3",

  // Circuito integrado.
  tecnologia:
    "M7.5 7.5h9v9h-9zM10 4.5v3M14 4.5v3M10 16.5v3M14 16.5v3M4.5 10h3M4.5 14h3M16.5 10h3M16.5 14h3",

  // Bola.
  desporto:
    "M12 4a8 8 0 1 0 0 16 8 8 0 0 0 0-16M12 8.2l3.4 2.5-1.3 4h-4.2l-1.3-4L12 8.2M12 4v4.2M18.9 9.4l-3.5 1.3M17 17.4l-2.9-2.7M7 17.4l2.9-2.7M5.1 9.4l3.5 1.3",

  // Mala de viagem: lê-se de imediato e não colide com o camião dos transportes.
  turismo_hotelaria:
    "M3.5 8h17v11.5h-17zM9 8V6a1.6 1.6 0 0 1 1.6-1.6h2.8A1.6 1.6 0 0 1 15 6v2M3.5 13h17M9.5 19.5v1.5M14.5 19.5v1.5",
};

const caminho = D[setor];
---

{caminho && (
  <svg
    width={tamanho}
    height={tamanho}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={clase}
    aria-hidden="true"
    focusable="false"
  >
    <path d={caminho} />
  </svg>
)}
