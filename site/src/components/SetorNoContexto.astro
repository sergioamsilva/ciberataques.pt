---
/*
 * Quanto pesa este setor lá fora, e quanto pesa aqui.
 *
 * Duas barras por ano, à mesma escala: a percentagem que o setor representa na
 * contagem oficial, e a que representa neste arquivo. Onde a segunda é muito menor,
 * é cobertura que falta — não é o fenómeno que muda.
 *
 * A correspondência entre taxonomias é aproximada, e cada ano diz de que categoria
 * da fonte veio o seu número. Antes havia aqui uma frase genérica a dar um exemplo
 * fixo, e a frase envelheceu mal: continuava a dizer que "prestadores de serviços de
 * internet" correspondia a "tecnologia" depois de a correspondência ter mudado.
 * Mostrar a categoria de cada valor não envelhece, e deixa o leitor auditá-la.
 */
import { setorNoContexto } from "../lib/dados";

interface Props {
  setor: string;
}
const { setor } = Astro.props;
const anos = setorNoContexto(setor);
const pct = (n: number, t: number) => (t ? Math.round((n / t) * 100) : 0);
---

{anos.length > 0 && (
  <section class="revelar contexto-setor mt-14" aria-labelledby="h-ctx-setor">
    <h2 id="h-ctx-setor" class="regua pt-4 text-2xl">Quanto disto se sabe</h2>
    <p class="mt-2 max-w-2xl text-sm text-[var(--color-suave)]">
      O peso deste setor na contagem oficial, ao lado do peso que tem neste arquivo.
      Onde a diferença é grande, é cobertura que falta — não é o fenómeno que muda.
    </p>

    <ol class="mt-6 divide-y divide-[var(--color-borda)] border-y border-[var(--color-borda)]" role="list">
      {anos.map((a) => {
        const meu = pct(a.neste_registo, a.total_do_ano_neste_registo);
        return (
          <li class="py-4">
            <div class="flex flex-wrap items-baseline gap-x-3">
              <span class="font-mono text-sm tabular-nums text-[var(--color-suave)]">{a.ano}</span>
              <span class="mono-etiqueta">{a.origem}</span>
              {a.categoria && (
                <span class="text-sm text-[var(--color-suave)]">
                  categoria <span class="text-[var(--color-corpo)]">{a.categoria}</span>
                  {a.numero !== undefined && <span> — {a.numero} incidentes</span>}
                </span>
              )}
            </div>

            <div class="mt-3 space-y-2">
              <div class="flex items-center gap-3">
                <span class="w-24 shrink-0 font-mono text-xs tabular-nums text-[var(--color-suave)]">
                  oficial
                </span>
                <span
                  class="barra-ctx block h-2.5 bg-[var(--color-tinta)]"
                  style={`width: ${Math.max(1, a.percentagem_oficial)}%`}
                  aria-hidden="true"
                ></span>
                <span class="font-mono text-xs tabular-nums">{a.percentagem_oficial}%</span>
              </div>
              <div class="flex items-center gap-3">
                <span class="w-24 shrink-0 font-mono text-xs tabular-nums text-[var(--color-suave)]">
                  neste arquivo
                </span>
                <span
                  class="barra-ctx block h-2.5 bg-[var(--color-acento)]"
                  style={`width: ${Math.max(0.6, meu)}%`}
                  aria-hidden="true"
                ></span>
                <span class="font-mono text-xs tabular-nums">
                  {meu}% <span class="text-[var(--color-suave)]">({a.neste_registo} de {a.total_do_ano_neste_registo})</span>
                </span>
              </div>
            </div>

            {/* A ressalva da fonte fica junto do número que ela ressalva, e não
                numa nota geral no fim: em 2023 a subida dos prestadores de serviços
                de internet é, nas palavras do CERT.PT, em parte uma alteração
                metodológica. Lida longe do 26%, essa informação não serve de nada.

                A do setor primeiro, porque é a que fala deste número. A do ano só
                depois, e nunca em vez dela: quando partilhavam campo, a página da
                saúde acabava a explicar os prestadores de serviços de internet. */}
            {a.notaDoSetor && (
              <p class="mt-3 max-w-2xl text-sm text-[var(--color-suave)]">{a.notaDoSetor}</p>
            )}
            {a.nota && (
              <p class="mt-2 max-w-2xl text-sm text-[var(--color-suave)]">{a.nota}</p>
            )}
            {/* A base de cálculo mudou entre edições do CERT.PT, o que torna as
                percentagens de anos diferentes incomparáveis entre si. Sem isto, a
                coluna "oficial" convida a uma leitura de tendência que os dados não
                sustentam. */}
            {a.baseNota && (
              <p class="mt-2 max-w-2xl text-sm text-[var(--color-suave)]">{a.baseNota}</p>
            )}
          </li>
        );
      })}
    </ol>

    <p class="mt-4 max-w-2xl text-sm text-[var(--color-suave)]">
      Os dois números não medem exatamente a mesma coisa. A classificação do CERT.PT
      não é a nossa, e por isso cada ano mostra acima de que categoria da fonte saiu o
      seu valor — é aproximada por construção, e serve para comparar ordens de
      grandeza, não para subtrair.{" "}
      <a href="/metodologia/#vies">O viés que herdamos</a>.
    </p>
  </section>
)}

<style>
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .contexto-setor .barra-ctx {
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }
    :global(html.js) .contexto-setor.visivel .barra-ctx {
      transform: scaleX(1);
    }
  }
</style>
