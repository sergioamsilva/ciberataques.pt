---
import Confianca from "./Confianca.astro";
import { formatarData, nome, entidades, type ResumoIncidente } from "../lib/dados";

interface Props {
  incidente: ResumoIncidente;
  /** Filtros do Pagefind: só os aplicamos na listagem geral, para não duplicar o índice. */
  indexavel?: boolean;
}
const { incidente: inc, indexavel = false } = Astro.props;
const todas = entidades();
const alvos = inc.entidades_afetadas
  .map((e) => todas[e]?.nome_curto ?? todas[e]?.nome ?? e)
  .join(", ");

const filtros = indexavel
  ? {
      "data-pagefind-filter": `ano:${inc.ano}, setor:${nome("setores", inc.setor)}, confirmação:${nome("estados_confirmacao", inc.estado_confirmacao)}`,
    }
  : {};
---

<article class="revelar group regua py-6" {...filtros}>
  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
    <span class="mono-etiqueta tabular-nums">
      <time datetime={inc.data}>{formatarData(inc.data, inc.precisao_data)}</time>
    </span>
    <Confianca estado={inc.estado_confirmacao} />
  </div>

  <h3 class="mt-2 text-xl">
    <a href={`/incidentes/${inc.id}/`} class="no-underline hover:underline">
      {inc.titulo}
      {/* A régua que cresce no hover: a micro-interação de marca do site. */}
      <span
        class="mt-1 block h-px w-0 bg-[var(--color-acento)] transition-all duration-300 group-hover:w-12"
        aria-hidden="true"
      ></span>
    </a>
  </h3>

  <p class="mt-1.5 text-sm text-[var(--color-suave)]">{alvos}</p>

  <ul class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1">
    <li class="mono-etiqueta">{nome("setores", inc.setor)}</li>
    {inc.tipos_ataque.map((t) => (
      <li class="mono-etiqueta">{nome("tipos_ataque", t)}</li>
    ))}
    {inc.ator && <li class="mono-etiqueta text-[var(--color-acento)]">{inc.ator}</li>}
    <li class="mono-etiqueta tabular-nums">
      {inc.n_fontes} {inc.n_fontes === 1 ? "fonte" : "fontes"}
    </li>
    {inc.tem_disputas && <li class="mono-etiqueta">versões em confronto</li>}
  </ul>
</article>
