---
import Confianca from "./Confianca.astro";
import {
  corDeConfianca,
  formatarData,
  nome,
  entidades,
  type ResumoIncidente,
} from "../lib/dados";

interface Props {
  incidente: ResumoIncidente;
  /** Filtros do Pagefind: só os aplicamos na listagem geral, para não duplicar o índice. */
  indexavel?: boolean;
  /** Nível do título: 2 quando a lista vem logo a seguir ao h1 da página. */
  nivel?: 2 | 3;
}
const { incidente: inc, indexavel = false, nivel = 3 } = Astro.props;
const Titulo = nivel === 2 ? "h2" : "h3";
const todas = entidades();
const alvos = inc.entidades_afetadas
  .map((e) => todas[e]?.nome_curto ?? todas[e]?.nome ?? e)
  .join(", ");

const filtros = indexavel
  ? {
      "data-pagefind-filter": `ano:${inc.ano}, setor:${nome("setores", inc.setor)}, confirmação:${nome("estados_confirmacao", inc.estado_confirmacao)}`,
    }
  : {};
---

{/*
  O filete de confirmação à esquerda.

  É a alteração que faz esta listagem dizer, de relance, aquilo que o site existe
  para dizer: quais destes casos estão sustentados e quais são a palavra de quem
  diz ter atacado. Antes, os dois liam-se como duas etiquetas cinzentas iguais.

  A cor vem da rampa ordinal validada e nunca vai sozinha — o rótulo em texto
  continua ao lado, porque uma cor não se lê em voz alta nem sobrevive a um leitor
  de ecrã. E vem primeiro que a data, porque é a informação mais importante da
  linha.
*/}
<article
  class="revelar group regua border-l-2 py-6 pl-5 transition-[padding-left] duration-200 hover:pl-6"
  style={`border-left-color: ${corDeConfianca(inc.estado_confirmacao)}`}
  {...filtros}
>
  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
    <Confianca estado={inc.estado_confirmacao} />
    <span class="mono-etiqueta tabular-nums">
      <time datetime={inc.data}>{formatarData(inc.data, inc.precisao_data)}</time>
    </span>
  </div>

  <Titulo class="mt-2 text-xl">
    <a href={`/incidentes/${inc.id}/`} class="no-underline hover:underline">
      {inc.titulo}
      {/* A régua que cresce no hover: a micro-interação de marca do site. */}
      <span
        class="mt-1 block h-px w-0 bg-[var(--color-acento)] transition-all duration-300 group-hover:w-12"
        aria-hidden="true"
      ></span>
    </a>
  </Titulo>

  <p class="mt-1.5 text-sm text-[var(--color-suave)]">{alvos}</p>

  <ul class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1">
    <li class="mono-etiqueta">{nome("setores", inc.setor)}</li>
    {inc.tipos_ataque.map((t) => (
      <li class="mono-etiqueta">{nome("tipos_ataque", t)}</li>
    ))}
    {/*
      O nome do grupo atacante esteve na cor de acento. Era o pior destino possível
      para a única cor do site: dava destaque cromático à marca de quem ataca, num
      registo cuja razão de ser é o contrário disso. Fica em tinta corrente,
      precedido da palavra que diz o que é — uma reivindicação, não um facto.
    */}
    {inc.ator && (
      <li class="mono-etiqueta">
        reivindicado por <span class="text-[var(--color-corpo)]">{inc.ator}</span>
      </li>
    )}
    <li class="mono-etiqueta tabular-nums">
      {inc.n_fontes} {inc.n_fontes === 1 ? "fonte" : "fontes"}
    </li>
    {inc.tem_disputas && (
      <li class="mono-etiqueta text-[var(--color-acento)]">versões em confronto</li>
    )}
  </ul>
</article>
